{
  "name": "dsh-preset-manager",
  "version": "0.1.0-test.1",
  "description": "Installed-only Preset, Plugin and Skills manager for DSH, forked from dsh-modes",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "agent-preset",
    "system-prompt"
  ],
  "author": "xiaohai-78",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EJYDOvO/dsh-preset-manager.git"
  },
  "homepage": "https://github.com/EJYDOvO/dsh-preset-manager",
  "bugs": {
    "url": "https://github.com/EJYDOvO/dsh-preset-manager/issues"
  },
  "type": "module",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./container": "./container.js",
    "./live-persona": "./live-persona.js",
    "./prompt-tool": "./prompt-tool.js",
    "./tool-descriptions": "./tool-descriptions.js",
    "./skills": "./skill-policy.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "install-guard.js",
    "container.js",
    "live-persona.js",
    "prompt-tool.js",
    "tool-descriptions.js",
    "tool-edit.js",
    "update.js",
    "skill-policy.js",
    "skill-store.js",
    "skill-files.js",
    "skill-import.js",
    "fs-retry.js",
    "rebase.js",
    "state.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "preset-plugins.js",
    "UPSTREAM.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:host": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-host.ps1"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection"
      ]
    },
    "upstream": {
      "repository": "https://github.com/xiaohai-78/dsh-modes",
      "commit": "c6d00b9da814328c27b1e9cf5b8f50c85814dfa9",
      "version": "0.9.1",
      "license": "MIT"
    }
  },
  "contributors": [
    "EJYDOvO (Preset Manager fork)"
  ]
}
