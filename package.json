{
  "name": "dsh-modes",
  "version": "0.7.0",
  "description": "Mode manager for DeepSeek Harness (dsh): switch what each agent mode can do, edit its system prompt with history and live updates, create modes from templates, and merge built-in updates after a dsh upgrade.",
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "cordis", "agent-preset", "system-prompt"],
  "author": "xiaohai-78",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaohai-78/dsh-modes.git"
  },
  "homepage": "https://github.com/xiaohai-78/dsh-modes#readme",
  "bugs": {
    "url": "https://github.com/xiaohai-78/dsh-modes/issues"
  },
  "type": "module",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./container": "./container.js",
    "./live-persona": "./live-persona.js",
    "./prompt-tool": "./prompt-tool.js",
    "./tool-descriptions": "./tool-descriptions.js",
    "./skills": "./skill-policy.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "container.js", "live-persona.js", "prompt-tool.js", "tool-descriptions.js", "tool-edit.js", "update.js", "skill-policy.js", "skill-store.js", "skill-files.js", "fs-retry.js", "rebase.js", "state.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "scripts": {
    "test": "node --test test/"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-settings"]
    }
  }
}
